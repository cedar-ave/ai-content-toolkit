# Copy this file to .env (repo root) and fill in real values.
# .env is git-ignored — never commit real credentials.
#
# Every MCP server under mcp/ loads this single file via python-dotenv.
# You only need to fill in the sections for the servers you actually use.

# --- Google Drive / Docs / Sheets / Slides (mcp/gdrive_mcp.py) -------------
# Auth for this server is OAuth via a downloaded Google Cloud client secret,
# not an env var. Place it at mcp/credentials.json (see README "Google Drive
# setup"). The first tool call opens a browser consent screen and caches the
# resulting token at mcp/token.json.
GDRIVE_DEFAULT_FOLDER_ID=

# --- Paligo (mcp/paligo_mcp.py) --------------------------------------------
# PALIGO_INSTANCE is the host only, e.g. "example.paligoapp.com"
PALIGO_INSTANCE=
# Pre-encoded Base64 "username:apikey" string
PALIGO_API_TOKEN=

# --- Zendesk Help Center / theming (mcp/zendesk_guide_mcp.py) -------------
# Production — Basic Auth
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
# Sandbox — OAuth client credentials grant
ZENDESK_SANDBOX_SUBDOMAIN=
ZENDESK_SANDBOX_CLIENT_ID=
ZENDESK_SANDBOX_CLIENT_SECRET=

# --- Zendesk Tickets, read-only (mcp/zendesk_tickets_mcp.py) --------------
# Reuses the same production Basic Auth credentials as above. If you only
# use the tickets server, you can set just these three:
# ZENDESK_SUBDOMAIN=
# ZENDESK_EMAIL=
# ZENDESK_API_TOKEN=
